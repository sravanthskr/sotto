# Sotto / voiceStra — environment template
# Copy this file to .env and fill in at least one provider key.
# Keys can also be entered inside the app (Settings -> Accounts) — recommended for most users.

# OpenRouter (free tier available)
OPENROUTER_API_KEY=

# Groq (free tier available)
GROQ_API_KEY=

# Google Gemini (free tier available)
GEMINI_API_KEY=

# GitHub Models
GITHUB_TOKEN=
